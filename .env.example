# Copiez ce fichier sous le nom .env et complétez les valeurs.
# Gardez AI_API_KEY secrète et ne la publiez jamais.
APP_NAME=Conseiller IA Médical Global Biotek
SECRET_KEY=changez-cette-cle-avec-une-longue-valeur-aleatoire
DATABASE_PATH=data/global_biotek.db

# Fournisseur compatible avec l'API de chat completions.
# Exemple de base URL : https://api.openai.com/v1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45
